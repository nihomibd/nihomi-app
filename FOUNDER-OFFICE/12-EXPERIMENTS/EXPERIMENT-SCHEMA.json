{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NihomiExperimentRecord",
  "type": "object",
  "required": [
    "experiment_id",
    "objective",
    "hypothesis",
    "variants",
    "primary_metric",
    "sample_size_target",
    "status",
    "start_date",
    "end_date",
    "result_metric",
    "conclusion"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{4}-[0-9]{3,}$"
    },
    "objective": { "type": "string" },
    "hypothesis": { "type": "string" },
    "variants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primary_metric": { "type": "string" },
    "sample_size_target": { "type": "integer" },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "ACTIVE", "CONVERGED", "ABANDONED"]
    },
    "start_date": { "type": "string", "format": "date-time" },
    "end_date": { "type": "string", "format": "date-time" },
    "result_metric": { "type": "string" },
    "conclusion": { "type": "string" }
  }
}
